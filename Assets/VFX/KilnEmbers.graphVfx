    Node12:
      DependencyIndex: 12
      LevelID: 102
      NodeCount: 0
      NodeType: 1
      Ports:
        BaseTex:
          ClassType2: TEXTURE_OBJECT_2D
          Connection0:
            NodeLevelID: 16
            PortID: Texture
        Code:
          ClassType1: TEXT
          String: |
            input_texture_2d BaseTex;
            
            void main()
            {
            	vec2 uv = system.getSurfaceUVCoord0();
            	// Soft round spark computed in code rather than sampled from a texture.
            	// The shipped BaseTex is unbound here, and an unbound sample renders the
            	// quad as a dark square - the worst possible result on a waveguide, where
            	// the shape should be a bright point that fades to nothing at the edges.
            	float d = length(uv - vec2(0.5)) * 2.0;
            	float core = 1.0 - smoothstep(0.0, 1.0, clamp(d, 0.0, 1.0));
            	float a = core * core;
            	vec4 particleColor = system.getParticleColor();
            	// Hot centre: push the core toward white so each ember has a bright heart.
            	vec3 rgb = mix(particleColor.rgb, vec3(1.0, 0.97, 0.88), core * 0.55);
            	system.setPixelColor0(vec4(rgb, particleColor.a * a));
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 102
        Locked:
          Variable: false
        ParticleIn:
          ClassType2: PARTICLE
          Connection0:
            NodeLevelID: 0
            PortID: ParticleOut
        ParticleOut:
          ClassType2: PARTICLE
          IOType: 1
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Set Color ( Pixel )
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
      PositionX: -140
      PositionY: 1468
      TemplateID: node_util_custom_container_output_pixel
