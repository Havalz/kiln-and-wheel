    Node4:
      DependencyIndex: 4
      LevelID: 100
      NodeCount: 0
      NodeType: 1
      Ports:
        AttractRepelStrength:
          Variable: 38.0
        AttractRepelTarget:
          Variable: [0.0, 70.0, 0.0]
        Code:
          ClassType1: TEXT
          String: |
            input_float SpawnVolumeRadius;
            input_vec3 SpawnVolumeScale;
            input_vec3 SpawnVolumeCenter;
            
            input_bool SizeMode;
            input_vec2 SizeMinMax;
            input_float SizeMul;
            
            input_vec2 MassMinMax;
            
            input_float AttractRepelStrength;
            input_vec3 AttractRepelTarget;
            
            input_vec4 ColorA;
            input_vec4 ColorB;
            
            input_float Life;
            
            void main()
            {
            	// Position (full-volume sphere)
            	vec3 rand1 = system.getParticleRandomVec3(true, true, true, 0.0);
            	vec3 rand2 = system.getParticleRandomVec3(true, true, true, 150.0);
            
            	rand1 = sqrt(rand1);
            
            	rand2 = mix(vec3(-1.0), vec3(1.0), rand2);
            	rand2 /= length(rand2 + 0.0001);
            
            	vec3 pos = rand1 * rand2 * SpawnVolumeScale * SpawnVolumeRadius;
            
            	pos += SpawnVolumeCenter;
            	system.setParticlePosition(pos);
            
            	// Size (random range, optional Normalize-to-AABB)
            	float sizeRand = system.getParticleRandomFloat(true, true, true, 20.0);
            	sizeRand = mix(SizeMinMax.x * SizeMul, SizeMinMax.y * SizeMul, sizeRand);
            	float localSize = length(system.getAABBMaxLocal() - system.getAABBMinLocal());
            	system.setParticleSize(SizeMode ? localSize * sizeRand : sizeRand);
            
            	// Mass (random range)
            	float massRand = system.getParticleRandomFloat(true, true, true, 30.0);
            	system.setParticleMass(mix(MassMinMax.x, MassMinMax.y, massRand));
            
            	// Force (attract / repel toward AttractRepelTarget)
            	vec3 toTarget = AttractRepelTarget - pos;
            	vec3 dir = toTarget / max(length(toTarget), 0.0001);
            	system.setParticleForce(system.getParticleForce() + dir * AttractRepelStrength);
            
            	// Color (random mix between A and B — single float bias so each particle is a uniform tint)
            	float colorRand = system.getParticleRandomFloat(true, true, true, 40.0);
            	system.setParticleColor(mix(ColorA, ColorB, colorRand));
            
            	// Life
            	system.setParticleLife(Life);
            }

        ColorA:
          Variable: [1.0, 0.45, 0.10, 1.0]
        ColorB:
          Variable: [1.0, 0.92, 0.55, 1.0]
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 100
        Life:
          Variable: 1.8
        Locked:
          Variable: false
        MassMinMax:
          Variable: [0.18, 0.45]
        ParticleIn:
          ClassType2: PARTICLE
          Connection0:
            NodeLevelID: 61
            PortID: Particle
        ParticleOut:
          ClassType2: PARTICLE
          IOType: 1
        SizeMinMax:
          Variable: [0.5, 1.3]
        SizeMode:
          Variable: 0.0
        SizeMul:
          Variable: 1.0
        SpawnVolumeCenter:
          Variable: [0.0, 2.0, 0.0]
        SpawnVolumeRadius:
          Variable: 9.0
        SpawnVolumeScale:
          Variable: [1.0, 0.18, 1.0]
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Initialize Particle
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
