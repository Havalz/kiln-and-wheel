    Node7:
      DependencyIndex: 7
      LevelID: 101
      NodeCount: 0
      NodeType: 1
      Ports:
        AlphaFadeInOutTime:
          Variable: [0.12, 0.62]
        AlphaMinMax:
          Variable: [0.0, 1.0]
        Area:
          Variable: 1.0
        Code:
          ClassType1: TEXT
          String: |
            input_vec2 AlphaMinMax;
            input_vec2 AlphaFadeInOutTime;
            
            input_float DragCoefficient;
            input_float Density;
            input_float Area;
            
            float attackDecay(float controlValue, float attackTime, float decayTime) {
            	float rise = clamp(controlValue / attackTime, 0.0, 1.0);
            	float fall = clamp((1.0 - controlValue) / decayTime, 0.0, 1.0);
            	return rise * fall;
            }
            
            void main()
            {
            	// Alpha fade in / out by particle age
            	float pAge = system.getParticleAgeRatio();
            	float pLife = system.getParticleLife();
            	vec4 pColor = system.getParticleColor();
            
            	float ratio = attackDecay(pAge, AlphaFadeInOutTime.x / pLife, AlphaFadeInOutTime.y / pLife);
            	pColor.a = mix(AlphaMinMax.x, AlphaMinMax.y, ratio);
            	system.setParticleColor(pColor);
            
            	// Drag force
            	vec3 vel = system.getParticleVelocity();
            	float mass = system.getParticleMass();
            
            	vec3 dragForce = -vel * length(vel) * DragCoefficient * Density * Area * 0.5;
            	vec3 limit = abs(vel * mass) / system.getTimeDelta();
            	dragForce = clamp(dragForce, -limit, limit);
            
            	system.setParticleForce(system.getParticleForce() + dragForce);
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Density:
          Variable: 1.2
        Description:
          ClassType1: TEXT
          String: ""
        DragCoefficient:
          Variable: 0.14
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 101
        Locked:
          Variable: false
        ParticleIn:
          ClassType2: PARTICLE
          Connection0:
            NodeLevelID: 85
            PortID: ParticleOut
        ParticleOut:
          ClassType2: PARTICLE
          IOType: 1
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Update Particle
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
      PositionX: -140
      PositionY: 835
      TemplateID: node_util_custom_container_update
      Title1: Update Particle
