  InputLines:
    - '// @ui {"widget":"label", "label":"Share QR — shown at the Kiln after firing"}'
    - '// @ui {"widget":"separator"}'
    - '// @input string githubUser {"hint":"GitHub user in https://<user>.github.io/kiln-and-wheel/#v1.<payload>"}'
    - '// @ui {"widget":"group_start", "label":"Display"}'
    - '// @input Component.Image qrImage {"hint":"Image component that shows the QR texture. Wire this OR qrMesh; both is fine."}'
    - '// @input Component.RenderMeshVisual qrMesh {"hint":"RenderMeshVisual alternative to qrImage, for a quad in world space."}'
    - '// @input Component.Text urlText {"hint":"Text under the QR showing the full URL. This is the fallback that must always work."}'
    - '// @input SceneObject backingPlate {"hint":"Opaque white backing plate behind the QR. The waveguide cannot render dark, so this supplies the light field."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Source"}'
    - '// @input AssignableType_1 kiln {"hint":"Fires the export. Without it nothing ever calls showFor()."}'
    - '// @input AssignableType_2 mesher {"hint":"Supplies the silhouette and the lathe parameters that get encoded."}'
    - '// @input SceneObject panelAnchor {"hint":"Anchor for the self-built panel. Left empty, the panel hangs off this SceneObject."}'
    - '// @input Asset.Material panelMaterial {"hint":"Unlit material for the QR quad. Needs ENABLE_BASE_TEX ON, or baseTex is a silent no-op and the code never appears."}'
    - '// @input Asset.Material plateMaterial {"hint":"Unlit white material for the backing plate. MUST be a different asset with ENABLE_BASE_TEX OFF - a texture-enabled material with no texture bound renders magenta."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Rendering"}'
    - '// @input bool flipVertical = true {"hint":"Flip rows when filling the texture. ProceduralTextureProvider fills bottom-up; leave on unless the QR renders mirrored — a mirrored QR never scans."}'
    - '// @ui {"widget":"group_end"}'
