  ScriptTypes:
    -
      {}
  InputLines:
    - '// @ui {"widget":"label", "label":"WHEEL Studio UI"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Layout"}'
    - '// @input float stationDistance = 45 {"hint":"Distance from the user to each station panel, in centimetres.", "widget":"slider", "min":25, "max":90, "step":1}'
    - '// @input float stationSpreadDeg = 60 {"hint":"Arc half-angle: the side stations sit this many degrees left and right of centre.", "widget":"slider", "min":20, "max":90, "step":5}'
    - '// @input float stationHeight = -19 {"hint":"Height of the side station panels relative to eye level, in centimetres.", "widget":"slider", "min":-45, "max":10, "step":1}'
    - '// @input float wheelPanelPitchDeg = 24 {"hint":"Upward pitch of the wheel control panel so it faces the user from below.", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Palette (waveguide: bright + saturated only)"}'
    - '// @input vec4 wheelFill = {1,0.6,0.2,0.5} {"hint":"Wheel panel fill. Bright and translucent - black would render invisible.", "widget":"color"}'
    - '// @input vec4 glazeFill = {0.15,0.8,1,0.5} {"hint":"Glaze bench panel fill.", "widget":"color"}'
    - '// @input vec4 kilnFill = {1,0.36,0.22,0.52} {"hint":"Kiln panel fill.", "widget":"color"}'
    - '// @input vec4 shelfFill = {0.62,0.42,1,0.46} {"hint":"Shelf panel fill. Cooler than the three working stations - finished work is not part of the active loop.", "widget":"color"}'
    - '// @input vec4 panelEdge = {1,0.93,0.78,0.85} {"hint":"Panel edge colour. Brighter than the fill so the panel reads as a solid object.", "widget":"color"}'
    - '// @input vec4 textPrimary = {1,1,1,1} {"hint":"Primary text. Near-white so it out-luminates the fill behind it.", "widget":"color"}'
    - '// @input vec4 textSecondary = {1,0.97,0.91,0.86} {"hint":"Secondary text - warm near-white, still high luminance.", "widget":"color"}'
    - '// @input vec4 textValue = {0.6,1,0.8,1} {"hint":"Live numeric readouts. Saturated mint reads clearly against the warm fill.", "widget":"color"}'
    - '// @input vec4 buttonFill = {1,0.46,0.06,0.34} {"hint":"Button face. Kept low-alpha: the button sits ON the panel and the two fills ADD, so a strong button would out-glow its own white label.", "widget":"color"}'
    - '// @input vec4 buttonHot = {1,0.7,0.24,0.6} {"hint":"Button face while hovered or pressed.", "widget":"color"}'
    - '// @input vec4 sliderTrack = {1,0.66,0.26,0.4} {"hint":"Slider groove.", "widget":"color"}'
    - '// @input vec4 sliderFill = {0.25,1,0.68,0.92} {"hint":"Filled portion of the slider - saturated so the current value reads at a glance.", "widget":"color"}'
    - '// @input vec4 sliderKnob = {1,1,0.97,1} {"hint":"Slider knob. Near-white: it must out-luminate the fill it sits on.", "widget":"color"}'
    - '// @input vec4 buttonBorder = {1,0.62,0.16,1} {"hint":"Outline colour of the action buttons. Their faces are transparent, so this border and the label are the only lit pixels in the cell.", "widget":"color"}'
    - '// @input vec4 buttonBorderHot = {0.35,1,0.72,1} {"hint":"Action button outline while hovered or pressed.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @input Asset.Material glazeMaterial {"hint":"GlazeMat. Cloned per shelf pot so each miniature keeps its own recipe."}'
    - '// @ui {"widget":"group_start", "label":"Labels"}'
    - '// @input string wheelTitle = "THE WHEEL" {"hint":"Title of the centre station."}'
    - '// @input string glazeTitle = "THE GLAZE BENCH" {"hint":"Title of the right-hand station."}'
    - '// @input string kilnTitle = "THE KILN" {"hint":"Title of the left-hand station."}'
    - '// @input string shelfTitle = "THE SHELF" {"hint":"Title of the shelf overhead."}'
    - '// @ui {"widget":"group_end"}'
    - "// @input float wheelNearFieldCm = 5 {\"hint\":\"Depth of the wheel panel's near-field grab slab, in cm. UIKit defaults to 17, which reaches well past the plate and steals pinches aimed at the profile handles floating in front of it. Just past the button faces is enough.\", \"widget\":\"slider\", \"min\":2, \"max\":17, \"step\":0.5}"
