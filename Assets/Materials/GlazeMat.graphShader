          Variable: [0.0, 0.0, 0.0, 0.0]
        bloomB:
          Connection0:
            NodeLevelID: 11
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        bloomC:
          Connection0:
            NodeLevelID: 12
