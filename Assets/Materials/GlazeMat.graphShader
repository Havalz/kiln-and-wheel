        glossBands:
          Connection0:
            NodeLevelID: 8
            PortID: Output
          Variable: [0.35, 0.0, 0.0, 0.0]
        firedGlow:
          Connection0:
            NodeLevelID: 9
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        bloomA:
          Connection0:
            NodeLevelID: 10
