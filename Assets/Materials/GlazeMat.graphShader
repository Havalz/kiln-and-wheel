    Node13:
      DependencyIndex: 13
      LevelID: 13
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 baseColorBottom;
            input_vec4 baseColorTop;
            input_float roughness;
            input_float metallic;
            input_float crackleScale;
            input_float crackleIntensity;
            input_float dripAmount;
            input_vec4 rimTint;
            input_float glossBands;
            input_float firedGlow;
            input_vec4 bloomA;
            input_vec4 bloomB;
            input_vec4 bloomC;
            output_vec4 result;

            // WAVEGUIDE FLOOR. Black is TRANSPARENT on this display, so no glaze may ever
            // reach true black or it stops existing. Every channel is lifted to a bright
            // desaturated warm grey; a "black" tenmoku reads as dark warm stone, not a hole.
            const vec3 GLAZE_FLOOR = vec3(0.40, 0.35, 0.30);

            // Crystal blooms are near-white with a warm bias: they are where the melt
            // crystallised and catches light, so they must out-luminate the glaze under them.
            const vec3 BLOOM_COLOR = vec3(1.0, 0.95, 0.82);

            vec2 hash22(vec2 p) {
            	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
            	return fract(sin(p) * 43758.5453);
            }

            // Distance between the two nearest Voronoi cell centres. Near a cell border the
            // two are equal, so the value approaches 0 -> that is where a crack line sits.
            float crackleEdge(vec2 uv) {
            	vec2 g = floor(uv);
            	vec2 f = fract(uv);
            	float d1 = 8.0;
            	float d2 = 8.0;
            	for (int y = -1; y <= 1; y++) {
            		for (int x = -1; x <= 1; x++) {
            			vec2 o = vec2(float(x), float(y));
            			vec2 r = o + hash22(g + o) - f;
            			float d = dot(r, r);
            			if (d < d1) { d2 = d1; d1 = d; }
            			else if (d < d2) { d2 = d; }
            		}
            	}
            	return sqrt(d2) - sqrt(d1);
            }

            /**
             * One crystal bloom. b = (height 0..1, angle 0..1, size, intensity).
             * Intensity 0 disables the slot, so unused blooms cost a compare and nothing else.
             * The angular term wraps the short way round the pot so a bloom sitting near the
             * seam does not get cut in half.
             */
            float bloomAt(vec4 b, float h, float angN) {
            	if (b.w <= 0.0) return 0.0;
            	float dh = h - b.x;
            	float da = abs(angN - b.y);
            	da = min(da, 1.0 - da);
            	// Angular distance is weighted up so blooms read as roundish patches on the
            	// surface rather than tall thin bands.
            	float d = sqrt(dh * dh + da * da * 2.2);
            	float s = max(b.z, 0.001);
            	float falloff = 1.0 - smoothstep(0.0, s, d);
            	return b.w * falloff * falloff;
            }

            void main()
            {
            	vec3 posL = system.getSurfacePositionObjectSpace();
            	vec3 bbMin = system.getAABBMinLocal();
            	vec3 bbMax = system.getAABBMaxLocal();

            	// Normalised height up the vessel: 0 at the foot, 1 at the rim. Driven from
            	// the local AABB so the gradient holds no matter what the lathe generates.
            	float h = clamp((posL.y - bbMin.y) / max(bbMax.y - bbMin.y, 0.0001), 0.0, 1.0);
            	float ang = atan(posL.z, posL.x);
            	float angN = ang * 0.15915494 + 0.5;   // -PI..PI -> 0..1

            	// ---- vertical gradient ------------------------------------------------
            	vec4 glaze = mix(baseColorBottom, baseColorTop, h);
            	vec3 col = glaze.rgb;

            	// ---- gravity glaze ----------------------------------------------------
            	// Glaze runs downhill: it pools and thickens through the bottom third and
            	// pulls thin off the rim. Thick glaze reads darker and more saturated.
            	float pool = 1.0 - smoothstep(0.0, 0.34, h);
            	float thin = smoothstep(0.70, 1.0, h);
            	// Runs vary with angle only, so streaks hang vertically like real drips.
            	float runSeed = fract(sin(ang * 21.17) * 43758.5453);
            	float runs = smoothstep(0.45, 1.0, runSeed) * (1.0 - smoothstep(0.0, 0.55, h));
            	float thickness = clamp(pool + runs * 0.65, 0.0, 1.0) * dripAmount;

            	col *= (1.0 - 0.42 * thickness);
            	col = mix(col, col * 1.18 + 0.05, thin * dripAmount);

            	// ---- crackle ----------------------------------------------------------
            	// Lines BRIGHTEN rather than darken. Real crackle is stained dark, but a
            	// dark line is invisible on a waveguide, so the network is rendered as
            	// light caught in the fissures instead.
            	float scale = max(crackleScale, 0.001);
            	float edge = crackleEdge(vec2(ang * 1.9, h * 3.4) * scale);
            	float lines = 1.0 - smoothstep(0.0, 0.075, edge);
            	col += lines * crackleIntensity * 0.5 * (0.6 + 0.4 * h);

            	// ---- crystal blooms ---------------------------------------------------
            	// Seeded by the kiln (see FiringSeed). Additive, so a bloom always brightens
            	// the glaze beneath it and can never punch a dark hole in the surface.
            	float bloom = bloomAt(bloomA, h, angN)
            	            + bloomAt(bloomB, h, angN)
            	            + bloomAt(bloomC, h, angN);
            	col += BLOOM_COLOR * bloom * 0.85;
            	// Crystals sit proud of the melt, so they also pick up extra crackle sparkle.
            	col += lines * bloom * 0.35;

            	// ---- specular / gloss banding -----------------------------------------
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 P = system.getSurfacePositionWorldSpace();
            	vec3 V = normalize(system.getCameraPosition() - P);
            	float ndv = clamp(dot(N, V), 0.0, 1.0);

            	// Metallic tints the highlight with the glaze colour; dielectric keeps it white.
            	vec3 specTint = mix(vec3(1.0), max(glaze.rgb, vec3(0.25)), clamp(metallic, 0.0, 1.0));
            	float band = sin(h * (18.0 + 46.0 * glossBands)) * 0.5 + 0.5;
            	float sharp = mix(1.5, 12.0, 1.0 - clamp(roughness, 0.0, 1.0));
            	float gloss = pow(band, sharp) * glossBands * (1.0 - 0.75 * clamp(roughness, 0.0, 1.0));
            	col += specTint * gloss * 0.35 * (1.0 - thickness * 0.5);

            	// ---- fresnel rim ------------------------------------------------------
            	float fres = pow(1.0 - ndv, 3.0);
            	col += rimTint.rgb * fres * rimTint.a;

            	// ---- kiln glow --------------------------------------------------------
            	// Warm emissive, hottest at the foot where a kiln's heat collects.
            	vec3 emberCol = vec3(1.0, 0.46, 0.13);
            	float ember = firedGlow * (0.55 + 0.45 * (1.0 - h));
            	col += emberCol * ember;

            	col = max(col, GLAZE_FLOOR);
            	result = vec4(col, glaze.a);
            }
